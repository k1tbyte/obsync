{
	"name": "obsync",
	"version": "1.1.0",
	"description": "Simple plugin to synchronize files to S3.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit"
	},
	"dependencies": {
		"@codemirror/merge": "^6.12.2",
		"diff": "^9.0.0",
		"ignore": "^7.0.6",
		"node-diff3": "^3.2.1",
		"obsidian": "latest",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/node": "^22.20.1",
		"@codemirror/commands": "^6.8.1",
		"@types/qrcode": "^1.5.6",
		"esbuild": "^0.25.12",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6"
	}
}
