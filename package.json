{
	"name": "obsync-monorepo",
	"version": "0.0.4",
	"description": "Monorepo for the Obsync Obsidian plugin and its companion services.",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.17.0",
	"scripts": {
		"build": "pnpm --filter obsync run build",
		"dev": "pnpm --filter obsync run dev",
		"test": "pnpm --filter obsync run test",
		"lint": "eslint \"packages/plugin/src/**/*.ts\"",
		"typecheck": "pnpm -r --if-present run typecheck",
		"version": "node version-bump.mjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^14.0.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"tslib": "^2.8.1",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.35.1"
	}
}
