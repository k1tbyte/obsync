{
	"name": "obsync-monorepo",
	"version": "1.1.0",
	"description": "Monorepo for the Obsync Obsidian plugin and its companion services.",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.17.0",
	"scripts": {
		"build": "pnpm --filter obsync run build",
		"dev": "pnpm --filter obsync run dev",
		"test": "pnpm --filter obsync run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm --filter obsync run typecheck",
		"version": "node version-bump.mjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"tslib": "^2.8.1",
		"typescript": "6.0.3"
	}
}
